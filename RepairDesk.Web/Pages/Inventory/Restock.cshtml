@page "{productId:int}"
@model RepairDesk.Web.Pages.Inventory.RestockModel
@{
    ViewData["Title"] = "Restock product";
}

@if (Model.Product is null)
{
    <h1>Product not found</h1>
}
else
{
    <h1>Restock @Model.Product.Name</h1>
    <p class="field-note">Current stock: @Model.Product.QuantityOnHand units.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <form method="post" class="stacked-form">
        <input type="hidden" asp-for="ProductId" />
        <div class="form-group">
            <label asp-for="Quantity">Quantity to add</label>
            <input asp-for="Quantity" type="number" min="1" required />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>
        <div class="action-row">
            <button type="submit" class="btn">Restock</button>
        </div>
    </form>
}
