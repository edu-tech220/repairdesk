@page
@model RepairDesk.Web.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Add product";
}

<h1>Add product</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

<form method="post" class="stacked-form">
    <div class="form-group">
        <label asp-for="Input.Sku"></label>
        <input asp-for="Input.Sku" required />
    </div>
    <div class="form-group">
        <label asp-for="Input.Name"></label>
        <input asp-for="Input.Name" required />
    </div>
    <div class="form-group">
        <label asp-for="Input.Category"></label>
        <input asp-for="Input.Category" required />
    </div>
    <div class="form-group">
        <label asp-for="Input.Price"></label>
        <input asp-for="Input.Price" type="number" step="0.01" min="0.01" required />
    </div>
    <div class="form-group">
        <label asp-for="Input.StandardWarrantyMonths"></label>
        <input asp-for="Input.StandardWarrantyMonths" type="number" min="1" max="120" required />
    </div>
    <div class="form-group">
        <label asp-for="Input.ExtendedWarrantyMonths"></label>
        <input asp-for="Input.ExtendedWarrantyMonths" type="number" min="1" max="120" required />
    </div>
    <div class="form-group">
        <label asp-for="Input.InitialQuantity"></label>
        <input asp-for="Input.InitialQuantity" type="number" min="0" required />
    </div>
    <div class="action-row">
        <button type="submit" class="btn">Create product</button>
    </div>
</form>
