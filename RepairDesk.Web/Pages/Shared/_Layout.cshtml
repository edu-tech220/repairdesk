@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RepairDesk</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="nav-bar">
            <a class="brand" asp-page="/Index">RepairDesk</a>
            <ul class="nav-links">
                <li><a asp-page="/Claims/New">Submit a claim</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li><a asp-page="/Cases/Index">Cases</a></li>
                    <li><a asp-page="/Products/Index">Products</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-page="/Devices/Register">Register device</a></li>
                    }
                    <li class="nav-user">@User.Identity!.Name (@User.FindFirst(ClaimTypes.Role)?.Value)</li>
                    <li><a asp-page="/Account/Logout">Sign out</a></li>
                }
                else
                {
                    <li><a asp-page="/Account/Login">Agent sign in</a></li>
                }
            </ul>
        </nav>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span>RepairDesk &mdash; electronics warranty &amp; RMA management</span>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
