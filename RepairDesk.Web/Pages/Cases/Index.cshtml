@page
@model RepairDesk.Web.Pages.Cases.IndexModel
@{
    ViewData["Title"] = "RMA cases";
}

<h1>RMA cases</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error">@Model.ErrorMessage</div>
}

<form method="get" class="filters">
    <div class="form-group">
        <label for="Status">Status</label>
        <select id="Status" name="Status">
            <option value="">All</option>
            @foreach (var status in Enum.GetValues<CaseStatus>())
            {
                <option value="@status" selected="@(Model.Status == status)">@status</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="Search">Serial number</label>
        <input id="Search" name="Search" value="@Model.Search" placeholder="Search by serial number" />
    </div>
    <div class="form-group">
        <button type="submit" class="btn">Filter</button>
    </div>
</form>

@if (Model.Cases is not null && Model.Cases.Items.Count > 0)
{
    <table>
        <thead>
            <tr>
                <th>Case</th>
                <th>Serial number</th>
                <th>Product</th>
                <th>Status</th>
                <th>Submitted</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Cases.Items)
            {
                <tr>
                    <td>#@item.Id</td>
                    <td>@item.SerialNumber</td>
                    <td>@item.ProductName</td>
                    <td><span class="badge @item.Status.CssBadgeClass()">@item.Status</span></td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td><a asp-page="/Cases/Details" asp-route-id="@item.Id">View</a></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination">
        <span>Page @Model.Cases.Page of @Math.Max(Model.Cases.TotalPages, 1) (@Model.Cases.TotalCount total)</span>
        @if (Model.Cases.Page > 1)
        {
            <a asp-page="/Cases/Index" asp-route-Status="@Model.Status" asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.Cases.Page - 1)">&laquo; Previous</a>
        }
        @if (Model.Cases.Page < Model.Cases.TotalPages)
        {
            <a asp-page="/Cases/Index" asp-route-Status="@Model.Status" asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.Cases.Page + 1)">Next &raquo;</a>
        }
    </div>
}
else
{
    <p class="field-note">No cases match the current filters.</p>
}
